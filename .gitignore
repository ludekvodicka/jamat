node_modules/
out/
dist/
build/

# This tree is also an SVN working copy; its metadata is never tracked by git.
.svn/

# Claude's own versioning store and the worktrees cut from it. SVN carries neither, and the public
# mirror must never see either: the store is a second history of this same tree.
.checkpoints/
.worktrees/

# Our per-user configs and launchers. Carried by SVN so they follow us across PCs, never by git:
# this tree gets a public mirror the day it ships, and nothing under here belongs in one.
.private/

# AI workflow artifacts and agent configuration. SVN-committed by convention, git-ignored here for
# the same reason as .private/: they are how the work was done, not the product.
.aidocs/
.claude/
.claude-home/
/CLAUDE.md
/project-planner.local.md

# Per-user secrets and machine-local data never reach a committed config.
*.local.json
.env
.env.*
*.pem
*.key
data/
# The testbed fixture ships a data/ directory of its own, and the rule above would swallow it.
!/configs/testbed/tree/data/
/AGENTS.md
*.tsbuildinfo

# The FileViewer testbed is a generated working copy with its own git repository and its own SVN
# working copy inside it. Its source lives in configs/testbed/; the built tree never belongs here.
# Rebuild it with `pnpm dev:testbed --force`.
/.testbed/

# This is a pnpm workspace: five pnpm roots, and CI installs every one of them with
# `pnpm install --frozen-lockfile`. Nothing reads an npm lockfile here, so a root one is a stray
# left by an `npm install <pkg>` run to try a dependency out - and a second lockfile that disagrees
# with pnpm-lock.yaml is worse than none. Anchored to the root on purpose:
# configs/remarkable-sidecar/package-lock.json is committed and load-bearing, because the sidecar
# seed is built by running `npm ci` against exactly it.
/package-lock.json

# docs/ is internal: architecture decisions, runbooks, and the notes that say how this tree works.
# The one exception is docs/images/, which the public README embeds. The export gate carries the
# same rule, so a miss here is a RED gate rather than a shipped leak - but the rule lives here too,
# because .gitignore is what decides the tracked set in the first place.
/docs/*
!/docs/images/
